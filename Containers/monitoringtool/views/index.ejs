<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitoring Tool</title>
  <!-- Include Chart.js library -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Include chartjs-adapter-date-fns -->
  <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }

    h1 {
      text-align: center;
    }

    ul {
      list-style-type: none;
      padding: 0;
      margin: 0;
    }

    li {
      margin-bottom: 10px;
    }

    #info-container {
      display: flex;
      justify-content: space-between;
      margin-top: 20px; /* Adjust top margin as needed */
    }

    
    #process-info {
      width: 40%; /* Adjust width as needed */
      margin: auto;      
    }


    #count-info,
    #average-info {
      width: 25%; /* Adjust width as needed */
      margin: auto;
      
    }

    #chart-container {
      display: flex;
      justify-content: space-around;
    }

    /* Add a CSS style to make canvases display in a row */
    canvas {
      display: inline-block;
      margin-right: 10px;
    }

        /* Increase the size of the charts */
    #chunk-chart canvas,
    #candidate-chart canvas,
    #clone-chart canvas {
      width: 600px;
      height: 500px;
    }
  </style>
 </head>
 <body>
  <h1>Monitoring Tool</h1>

  <div id="info-container">
    <div id="count-info" class="info-section">
      <h2>Counts</h2>
      <ul>
        <li>Files Count: <%= filesCount %></li>
        <li>Chunks Count: <%= chunksCount %></li>
        <li>Candidates Count: <%= candidatesCount %></li>
        <li>Clones Count: <%= clonesCount %></li>
      </ul>
    </div>

    <div id="process-info" class="info-section">
      <h2>Process Info</h2>
      <ul>
        <% statusUpdates.forEach(update => { %>
          <li><%= update.message %> - <%= update.timestamp %></li>
        <% }); %>
      </ul>
    </div>

    <div id="average-info" class="info-section">
      <h2>Averages</h2>
      <ul>
        <li>Average Number of Chunks Per File: <%= averageChunkSizePerFile %></li>
        <li>Average Clone Size (number of lines): <%= averageCloneSize %></li>
      </ul>
    </div>
  </div>

  <div id="chart-container">
    <div class="chart-section" id="chunk-chart">
      <h2>Chunk</h2>
      <canvas id="myChart" width="400" height="200"></canvas>
    </div>

    <div class="chart-section" id="candidate-chart">
      <h2>Clone Candidates</h2>
      <canvas id="myChart1" width="400" height="200"></canvas>
    </div>

    <div class="chart-section" id="clone-chart">
      <h2>Expanded Clones</h2>
      <canvas id="myChart2" width="400" height="200"></canvas>
    </div>
  </div>

  <!-- Include chart scripts and initialize charts -->
  <script src="../charts/chunkChart.js"></script>
  <script src="../charts/candidateChart.js"></script>
  <script src="../charts/cloneChart.js"></script>

  <script>
    createChunkChart(
      <%= JSON.stringify(times) %>,
      <%= JSON.stringify(chunckCounts) %>,
      'myChart'
    );
  </script>
  <script>
    createCandidateChart(
      <%= JSON.stringify(times) %>,
      <%= JSON.stringify(candidateCounts) %>,
      'myChart1'
    );
  </script>
  <script>
    createCloneChart(
      <%= JSON.stringify(times) %>,
      <%= JSON.stringify(cloneCounts) %>,
      'myChart2'
    );
  </script>
</body>
</html>
